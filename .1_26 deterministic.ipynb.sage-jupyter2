id(theta_star, shapes, x_np, t_np, usol_np)\n    print(f\"[EVAL] full-grid MSE={mse:.3e}, relL2={rel_l2:.3e}\")\n\n    plot_heatmaps(x_np, t_np, usol_np, u_pred)\n\n\nif __name__ == \"__main__\":\n    main()\n","kernel":"jax","output":{"0":{"name":"stdout","text":"loaded burgers.mat: t (201,) x (512,) usol (201, 512) nu 0.003183098861837907\nDomain: x in [-1.0, 1.0], t in [0.0, 1.0]\n"},"1":{"name":"stdout","text":"scale_obj (fixed anchor) = 1.0\nConstraint dimension M_CON = 1000\n"},"10":{"name":"stdout","text":"[iter=90] obj_s=1.227e-01 feas_true=6.279e-02 feas_noisy=6.279e-02 station=2.294e+00 tau=7.829317e-01 alpha=8.53e-03 beta=7.43e-01 lam=1.00e-03 kkt_res=2.8e-01 s=1.00e+00 | hold_data_K=20000 hold_con_K=20000 | jitter=gaussian sigx=0.0e+00 sigt=0.0e+00 clipk=2.0| RMS/max: PDE=(2.13e-01,5.08e-01) BCv=(1.17e-01,1.76e-01) BCd=(1.00e-01,1.52e-01) IC=(3.29e-01,4.83e-01) \n"},"11":{"name":"stdout","text":"[iter=100] obj_s=1.044e-01 feas_true=4.819e-02 feas_noisy=4.819e-02 station=1.492e+00 tau=7.829317e-01 alpha=1.47e-02 beta=7.23e-01 lam=1.00e-03 kkt_res=1.7e-01 s=1.00e+00 | hold_data_K=20000 hold_con_K=20000 | jitter=gaussian sigx=0.0e+00 sigt=0.0e+00 clipk=2.0| RMS/max: PDE=(1.87e-01,4.38e-01) BCv=(1.11e-01,1.64e-01) BCd=(9.71e-02,1.46e-01) IC=(2.89e-01,4.23e-01) \n"},"12":{"name":"stdout","text":"[iter=110] obj_s=8.867e-02 feas_true=3.059e-02 feas_noisy=3.059e-02 station=1.068e+00 tau=7.829317e-01 alpha=3.07e-02 beta=7.04e-01 lam=1.00e-03 kkt_res=8.6e-02 s=1.00e+00 | hold_data_K=20000 hold_con_K=20000 | jitter=gaussian sigx=0.0e+00 sigt=0.0e+00 clipk=2.0| RMS/max: PDE=(1.46e-01,3.38e-01) BCv=(9.52e-02,1.37e-01) BCd=(8.88e-02,1.31e-01) IC=(2.37e-01,3.42e-01) \n"},"13":{"name":"stdout","text":"[iter=120] obj_s=7.162e-02 feas_true=1.313e-02 feas_noisy=1.313e-02 station=5.430e-01 tau=7.829317e-01 alpha=4.82e-02 beta=6.87e-01 lam=1.00e-03 kkt_res=4.2e-02 s=1.00e+00 | hold_data_K=20000 hold_con_K=20000 | jitter=gaussian sigx=0.0e+00 sigt=0.0e+00 clipk=2.0| RMS/max: 