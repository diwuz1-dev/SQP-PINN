{"cell_type":"code","exec_count":1,"id":"e44e37","input":"# ================================\n# Stochastic SQP-PINN (JAX)\n# Objective: data MSE from burgers.mat (stochastic minibatch)\n# Constraints: PDE + periodic BC (value + derivative) + IC (all stochastic minibatches)\n#\n# Scaling:\n#   - Objective scale: FIXED anchor (computed once at theta0 from a small data batch)\n#   - Constraint scale: RMS + EMA on ||J||_rms (scalar), NO stale linearization\n#   - Optional LM invariance: use lam_eff = lam*(s_con^2) in KKT bottom-right\n#\n# NOTE: Fixes your JIT error by NOT using static_argnames=(\"shapes\",) on u_and_ux().\n# ================================\n\nimport os\nos.environ[\"JAX_PLATFORM_NAME\"] = \"cpu\"  # set BEFORE importing jax\n\nimport time\nimport math\nfrom functools import partial\n\nimport numpy as np\nimport scipy.io\n\nimport jax\nimport jax.numpy as jnp\nfrom jax import random, grad, vmap, hessian\n\n# -----------------------------\n# Precision\n# -----------------------------\nUSE_X64 = False  # set True if you want deeper convergence\njax.config.update(\"jax_enable_x64\", USE_X64)\nDTYPE = jnp.float64 if USE_X64 else jnp.float32\nEPS = 1e-12\n\n# -----------------------------\n# 1) MLP\n# -----------------------------\ndef init_mlp_params(key, layer_sizes):\n    params = []\n    keys = random.split(key, len(layer_sizes) - 1)\n    for k, (m, n) in zip(keys, zip(layer_sizes[:-1], layer_sizes[1:])):\n        W = random.normal(k, (m, n), dtype=DTYPE) * jnp.sqrt(DTYPE(2.0) / DTYPE(m))\n        b = jnp.zeros((n,), dtype=DTYPE)\n        params.append({\"W\": W, \"b\": b})\n    return params\n\ndef mlp_apply(params, x):\n    # x: (N,2) -> (N,1)\n    h = x\n    for i, layer in enumerate(params):\n        W, b = layer[\"W\"], layer[\"b\"]\n        h = h @ W + b\n        if i < len(params) - 1:\n            h = jnp.tanh(h)\n    return h\n\n# -----------------------------\n# 2) Flatten/unflatten\n# -----------------------------\ndef flatten_params(params):\n    flat_parts = []\n    shapes = []\n    for layer in params:\n        W, b = layer[\"W\"], layer[\"b\"]\n        flat_parts.append(W.reshape(-1))\n        flat_parts.append(b.reshape(-1))\n        shapes.append((W.shape, b.shape))\n    theta = jnp.concatenate(flat_parts).astype(DTYPE)\n    return theta, tuple(shapes)\n\ndef unflatten_params(theta, shapes):\n    params = []\n    idx = 0\n    for W_shape, b_shape in shapes:\n        W_size = math.prod(W_shape)\n        b_size = math.prod(b_shape)\n        W = theta[idx: idx + W_size].reshape(W_shape); idx += W_size\n        b = theta[idx: idx + b_size].reshape(b_shape); idx += b_size\n        params.append({\"W\": W, \"b\": b})\n    return params\n\n# -----------------------------\n# 3) Load burgers.mat and build data arrays\n# burgers.mat contains: t, x, nu, usol with shape (nt, nx)\n# -----------------------------\ndef load_burgers_mat(path):\n    d = scipy.io.loadmat(path)\n    t = d[\"t\"].squeeze()\n    x = d[\"x\"].squeeze()\n    usol = d[\"usol\"]  # (nt, nx)\n    nu = float(np.array(d[\"nu\"]).squeeze())\n    return t, x, usol, nu\n\ndef build_full_data_points(t_np, x_np, usol_np):\n    \"\"\"\n    Flatten grid into:\n      X_data: (N,2) columns [x,t]\n      u_data: (N,)\n    \"\"\"\n    T, X = np.meshgrid(t_np, x_np, indexing=\"ij\")        # (nt,nx)\n    X_data = np.stack([X.reshape(-1), T.reshape(-1)], 1) # (N,2)\n    u_data = usol_np.reshape(-1)                         # (N,)\n    return X_data, u_data\n\n# -----------------------------\n# 4) Sampling (stochastic minibatches)\n# -----------------------------\ndef sample_data_batch(key, X_data, u_data, B):\n    N = X_data.shape[0]\n    idx = random.randint(key, (B,), 0, N)\n    return X_data[idx], u_data[idx]\n\ndef sample_pde_batch(key, Bf):\n    # uniform in x∈[-1,1], t∈[0,1]\n    kx, kt = random.split(key, 2)\n    x = random.uniform(kx, (Bf, 1), minval=-1.0, maxval=1.0, dtype=DTYPE)\n    t = random.uniform(kt, (Bf, 1), minval=0.0, maxval=1.0, dtype=DTYPE)\n    return jnp.concatenate([x, t], axis=1)\n\ndef sample_bc_batch_periodic(key, Bbc):\n    # sample times, build pairs at x=-1 and x=+1\n    t = random.uniform(key, (Bbc, 1), minval=0.0, maxval=1.0, dtype=DTYPE)\n    left  = jnp.concatenate([-jnp.ones_like(t), t], axis=1)\n    right = jnp.concatenate([ jnp.ones_like(t), t], axis=1)\n    return left, right\n\ndef sample_ic_batch_from_grid(key, x_grid, u0_grid, Bic):\n    nx = x_grid.shape[0]\n    idx = random.randint(key, (Bic,), 0, nx)\n    x = x_grid[idx].reshape(-1, 1)\n    t = jnp.zeros_like(x)\n    Xic = jnp.concatenate([x, t], axis=1)\n    u0 = u0_grid[idx]\n    return Xic, u0\n\n# -----------------------------\n# 5) PDE residual: u_t + u u_x - nu u_xx\n# -----------------------------\ndef pde_residual_unscaled(params, X_f, nu):\n    def u_fun(xt):\n        return mlp_apply(params, xt[None, :])[0, 0]\n\n    u  = vmap(u_fun)(X_f)            # (Bf,)\n    du = vmap(grad(u_fun))(X_f)      # (Bf,2)\n    H  = vmap(hessian(u_fun))(X_f)   # (Bf,2,2)\n\n    u_x  = du[:, 0]\n    u_t  = du[:, 1]\n    u_xx = H[:, 0, 0]\n    return u_t + u * u_x - DTYPE(nu) * u_xx\n\n# -----------------------------\n# 6) Objective: data MSE\n# -----------------------------\ndef data_mse_unscaled(params, Xb, ub):\n    pred = mlp_apply(params, Xb)[:, 0]\n    return jnp.mean((pred - ub) ** 2)\n\n@partial(jax.jit, static_argnames=(\"shapes\",))\ndef F_and_g_data_scaled(theta, shapes, Xb, ub, scale_obj):\n    def obj_theta(th):\n        params = unflatten_params(th, shapes)\n        return data_mse_unscaled(params, Xb, ub)\n    val, g = jax.value_and_grad(obj_theta)(theta)\n    return scale_obj * val, scale_obj * g\n\ndef compute_scale_obj_data_anchor(theta0, shapes, X_anchor, u_anchor, target=100.0):\n    def obj_theta(th):\n        params = unflatten_params(th, shapes)\n        return data_mse_unscaled(params, X_anchor, u_anchor)\n    g0 = grad(obj_theta)(theta0)\n    ginf = jnp.linalg.norm(g0, jnp.inf)\n    return (DTYPE(target) / jnp.maximum(DTYPE(target), ginf + DTYPE(EPS))).astype(DTYPE)\n\n# -----------------------------\n# 7) Periodic BC helper: u and u_x (NO shapes arg, so NO static_argnames)\n# -----------------------------\n@jax.jit\ndef u_and_ux(params, X):\n    def u_fun(xt):\n        return mlp_apply(params, xt[None, :])[0, 0]\n    u = vmap(u_fun)(X)          # (N,)\n    du = vmap(grad(u_fun))(X)   # (N,2)\n    ux = du[:, 0]\n    return u, ux\n\n# -----------------------------\n# 8) Constraint vector: PDE + periodic BC (val+der) + IC\n# -----------------------------\n@partial(jax.jit, static_argnames=(\"shapes\",))\ndef constraint_vector_unscaled(theta, shapes, X_f, X_bc_L, X_bc_R, X_ic, u0_ic, nu):\n    params = unflatten_params(theta, shapes)\n\n    c_pde = pde_residual_unscaled(params, X_f, nu)  # (Bf,)\n\n    uL, uxL = u_and_ux(params, X_bc_L)\n    uR, uxR = u_and_ux(params, X_bc_R)\n    c_bc_val = uL - uR\n    c_bc_der = uxL - uxR\n\n    u_ic = mlp_apply(params, X_ic)[:, 0]\n    c_ic = u_ic - u0_ic\n\n    return jnp.concatenate([c_pde, c_bc_val, c_bc_der, c_ic], axis=0)\n\n@partial(jax.jit, static_argnames=(\"shapes\",))\ndef C_and_J_constraints_unscaled(theta, shapes, X_f, X_bc_L, X_bc_R, X_ic, u0_ic, nu):\n    def c_fun(th):\n        return constraint_vector_unscaled(th, shapes, X_f, X_bc_L, X_bc_R, X_ic, u0_ic, nu)\n\n    def c_fun_aux(th):\n        c = c_fun(th)\n        return c, c\n\n    J_un, c_un = jax.jacrev(c_fun_aux, has_aux=True)(theta)  # (m,n), (m,)\n    return c_un, J_un\n\n# -----------------------------\n# 9) RMS+EMA scaling for constraints (scalar)\n# -----------------------------\ndef ema_update(old, new, ema_alpha):\n    return (DTYPE(1.0) - DTYPE(ema_alpha)) * old + DTYPE(ema_alpha) * new\n\ndef scalar_scale_from_mag(mag, target):\n    return DTYPE(target) / jnp.maximum(DTYPE(target), mag + DTYPE(EPS))\n\n# -----------------------------\n# 10) KKT solve (LM proxy), with LM invariance lam_eff = lam*(s_con^2)\n# -----------------------------\n@jax.jit\ndef kkt_solve_once(H, Jac, Grad, Cons, lam_eff):\n    n = H.shape[0]\n    m = Cons.shape[0]\n    I_m = jnp.eye(m, dtype=H.dtype)\n    top = jnp.concatenate([H, Jac.T], axis=1)\n    bottom = jnp.concatenate([Jac, -lam_eff * I_m], axis=1)\n    KKT = jnp.concatenate([top, bottom], axis=0)\n    rhs = -jnp.concatenate([Grad, Cons])\n    sol = jnp.linalg.solve(KKT, rhs)\n    d = sol[:n]\n    y = sol[n:]\n    return d, y\n\ndef cal_d_and_y(H, Jac, Grad, Cons, s_con,\n               ridge_init=1e-6, eta_up=10.0, eta_down=0.25,\n               lam_min=1e-10, lam_max=10, res_tol=1e-6):\n    lam = float(jnp.clip(DTYPE(ridge_init), DTYPE(lam_min), DTYPE(lam_max)))\n    s2 = float(s_con * s_con)\n\n    for _ in range(12):\n        lam_eff = DTYPE(lam * s2)\n        d, y = kkt_solve_once(H, Jac, Grad, Cons, lam_eff)\n        res_vec = jnp.concatenate([H @ d + Jac.T @ y + Grad,\n                                   Jac @ d + Cons])\n        res_norm = float(jnp.linalg.norm(res_vec, 2))\n        if res_norm <= res_tol:\n            lam_next = float(jnp.clip(DTYPE(lam) * DTYPE(eta_down), DTYPE(lam_min), DTYPE(lam_max)))\n            return d, y, lam_next, res_norm\n        lam = float(jnp.clip(DTYPE(lam) * DTYPE(eta_up), DTYPE(lam_min), DTYPE(lam_max)))\n\n    lam_eff = DTYPE(lam * s2)\n    d, y = kkt_solve_once(H, Jac, Grad, Cons, lam_eff)\n    res_vec = jnp.concatenate([H @ d + Jac.T @ y + Grad,\n                               Jac @ d + Cons])\n    res_norm = float(jnp.linalg.norm(res_vec, 2))\n    return d, y, lam, res_norm\n\n# -----------------------------\n# 11) tau/ksi/alpha step-size logic\n# -----------------------------\ndef cal_tau(H, d_k, sigma, tau_pre, eps_tau, Grad, Cons):\n    denom = float(Grad @ d_k + 0.5 * (d_k @ (H @ d_k)))\n    if denom <= 1e-12:\n        tau_trial = float(\"inf\")\n    else:\n        val = (1.0 - sigma) * float(jnp.linalg.norm(Cons, 1))\n        tau_trial = val / denom\n    if tau_pre <= tau_trial:\n        return tau_pre\n    return min(tau_trial, (1.0 - eps_tau) * tau_pre)\n\ndef cal_ksi(d_k, tau, ksi_old, eps_ksi, Grad, Cons):\n    top = -tau * float(Grad @ d_k) + float(jnp.linalg.norm(Cons, 1))\n    denom = tau * float(jnp.linalg.norm(d_k) ** 2)\n    if denom <= 1e-18:\n        return ksi_old\n    ksi_trial = top / denom\n    if ksi_old <= ksi_trial:\n        return ksi_old\n    return min(ksi_trial, (1.0 - eps_ksi) * ksi_old)\n\ndef phi(alpha, eta, beta_k, tau, Grad, d_k, Cons, L, Gamma):\n    normC1 = float(jnp.linalg.norm(Cons, 1))\n    gd = float(Grad @ d_k)\n    d2 = float(d_k @ d_k)\n    term1 = (eta - 1.0) * alpha * beta_k * (-tau * gd + normC1)\n    term2 = (abs(1.0 - alpha) - 1.0 + alpha) * normC1\n    term3 = 0.5 * (tau * L + Gamma) * (alpha ** 2) * d2\n    return term1 + term2 + term3\n\ndef cal_alpha(d_k, eta, beta_k, ksi, tau, L, Gamma, theta_val, Grad, Cons):\n    denom = (tau * L + Gamma)\n    if denom <= 1e-12:\n        return 0.0\n    alpha_min = 2.0 * (1.0 - eta) * beta_k * ksi * tau / denom\n    alpha_k = max(alpha_min, 0.0)\n    while (phi(1.1 * alpha_k, eta, beta_k, tau, Grad, d_k, Cons, L, Gamma) < 0.0\n           and (1.1 * alpha_k < alpha_min + theta_val * beta_k)):\n        alpha_k *= 1.1\n    return float(alpha_k)\n\n# -----------------------------\n# 12) Main SQP loop\n# -----------------------------\ndef sqp_pinn_stochastic(\n    theta0, shapes,\n    X_data, u_data,\n    x_grid, u0_grid,\n    nu,\n    # batch sizes\n    B_data=256, B_f=256, B_bc=64, B_ic=64,\n    resample_every=10,\n    # scaling\n    scale_obj=DTYPE(1.0),       # fixed anchor\n    con_scale_target=100.0,\n    con_ema_alpha=0.05,\n    # SQP params\n    L=100.0, Gamma=100.0,\n    max_iters=5000,\n    print_every=50,\n    beta0=1.0, beta_shift=200.0, beta_power=0.6,\n    seed=0,\n):\n    key = random.PRNGKey(seed)\n    theta = theta0\n    n = theta.shape[0]\n    H = jnp.eye(n, dtype=DTYPE)\n\n    eta = 0.25\n    sigma = 0.1\n    eps_tau = 1e-2\n    eps_ksi = 1e-2\n    theta_val = 10.0\n    tau_k = 5.0\n    ksi_k = 1.0\n    lam_prev = 1e-6\n\n    # constraint scaling EMA state\n    Jmag_ema = DTYPE(0.0)\n    s_con = DTYPE(1.0)\n\n    # frozen minibatches\n    Xf_b = XbcL_b = XbcR_b = Xic_b = None\n    u0ic_b = None\n    Xdata_b = udata_b = None\n\n    t0 = time.time()\n    for k in range(1, max_iters + 1):\n        beta_k = float(min(1.0, beta0 * (beta_shift / (beta_shift + k)) ** beta_power))\n        resample = (k == 1) or ((k - 1) % resample_every == 0)\n\n        if resample:\n            key, k_data, k_f, k_bc, k_ic = random.split(key, 5)\n            Xdata_b, udata_b = sample_data_batch(k_data, X_data, u_data, B_data)\n            Xf_b = sample_pde_batch(k_f, B_f)\n            XbcL_b, XbcR_b = sample_bc_batch_periodic(k_bc, B_bc)\n            Xic_b, u0ic_b = sample_ic_batch_from_grid(k_ic, x_grid, u0_grid, B_ic)\n\n        # ----- Objective (data loss), scaled by fixed scale_obj -----\n        obj_s, g_s = F_and_g_data_scaled(theta, shapes, Xdata_b, udata_b, scale_obj)\n\n        # ----- Constraints (fresh linearization every iter) -----\n        c_un, J_un = C_and_J_constraints_unscaled(theta, shapes, Xf_b, XbcL_b, XbcR_b, Xic_b, u0ic_b, nu)\n\n        # update constraint scale only on resample\n        if resample:\n            J_rms = jnp.sqrt(jnp.mean(J_un**2) + DTYPE(EPS))\n            Jmag_ema = J_rms if (k == 1) else ema_update(Jmag_ema, J_rms, DTYPE(con_ema_alpha))\n            s_con = scalar_scale_from_mag(Jmag_ema, con_scale_target)\n            s_con = jax.lax.stop_gradient(s_con)\n\n        Cons = s_con * c_un\n        Jac  = s_con * J_un\n\n        # ----- KKT direction -----\n        d_k, y_k, lam_prev, kkt_res = cal_d_and_y(H, Jac, g_s, Cons, s_con, ridge_init=lam_prev)\n\n        # ----- step size -----\n        dir_norm = float(jnp.linalg.norm(d_k, jnp.inf))\n        if dir_norm > 1e-10:\n            tau_k = cal_tau(H, d_k, sigma, tau_k, eps_tau, g_s, Cons)\n            ksi_k = cal_ksi(d_k, tau_k, ksi_k, eps_ksi, g_s, Cons)\n            alpha = cal_alpha(d_k, eta, beta_k, ksi_k, tau_k, L, Gamma, theta_val, g_s, Cons)\n        else:\n            alpha = 2.0 * (1.0 - eta) * beta_k * ksi_k * tau_k / (tau_k * L + Gamma)\n\n        theta = theta + DTYPE(alpha) * d_k\n\n        if k % print_every == 0:\n            feas = float(jnp.mean(Cons**2))\n            station = float(jnp.linalg.norm(g_s + Jac.T @ y_k, jnp.inf))\n            print(f\"[iter={k}] obj_s={float(obj_s):.3e} feas={feas:.3e} station={station:.3e} \"\n                  f\"alpha={alpha:.2e} beta={beta_k:.2e} lam={lam_prev:.1e} kkt_res={kkt_res:.1e} \"\n                  f\"s_con={float(s_con):.2e}\")\n\n    print(f\"[done] elapsed={time.time()-t0:.2f}s\")\n    return theta\n\n# -----------------------------\n# 13) main\n# -----------------------------\ndef main():\n    # change path if needed\n    t_np, x_np, usol_np, nu = load_burgers_mat(\"data/burgers.mat\")\n    print(\"loaded burgers.mat:\", \"t\", t_np.shape, \"x\", x_np.shape, \"usol\", usol_np.shape, \"nu\", nu)\n\n    X_data_np, u_data_np = build_full_data_points(t_np, x_np, usol_np)\n    X_data = jnp.array(X_data_np, dtype=DTYPE)\n    u_data = jnp.array(u_data_np, dtype=DTYPE)\n\n    x_grid = jnp.array(x_np, dtype=DTYPE)\n    u0_grid = jnp.array(usol_np[0, :], dtype=DTYPE)  # t=0 row\n\n    # network\n    hidden_dim = 20\n    num_hidden = 3\n    layer_sizes = [2] + [hidden_dim] * num_hidden + [1]\n    key = random.PRNGKey(0)\n    key, key_params = random.split(key)\n    params0 = init_mlp_params(key_params, layer_sizes)\n    theta0, shapes = flatten_params(params0)\n\n    # fixed anchor scale for data objective\n    key_anchor = random.PRNGKey(123)\n    X_anchor, u_anchor = sample_data_batch(key_anchor, X_data, u_data, B=512)\n    scale_obj = compute_scale_obj_data_anchor(theta0, shapes, X_anchor, u_anchor, target=100.0)\n    print(\"scale_obj (fixed anchor) =\", float(scale_obj))\n\n    theta_star = sqp_pinn_stochastic(\n        theta0, shapes,\n        X_data, u_data,\n        x_grid, u0_grid,\n        nu=nu,\n        B_data=500, B_f=512, B_bc=128, B_ic=256,\n        resample_every=10000,\n        scale_obj=scale_obj,          # fixed objective scaling\n        con_scale_target=100.0,       # RMS+EMA for constraints\n        con_ema_alpha=0.05,\n        L=60.0, Gamma=60.0,\n        max_iters=10000,\n        print_every=1,\n        beta0=1.0, beta_shift=200.0, beta_power=0.8,\n        seed=0,\n    )\n\n    print(\"Final theta shape:\", theta_star.shape)\n\n    # Save so you can evaluate later even if kernel restarts\n    np.save(\"theta_star.npy\", np.array(theta_star))\n\n    # IMPORTANT: return values so you can unpack them\n    return theta_star, shapes, (t_np, x_np, usol_np, nu)\n\n\ntheta_star, shapes, (t_np, x_np, usol_np, nu) = main()\n","kernel":"jax","output":{"0":{"name":"stdout","text":"loaded burgers.mat: t (201,) x (512,) usol (201, 512) nu 0.003183098861837907\n"},"1":{"name":"stdout","text":"scale_obj (fixed anchor) = 1.0\n"},"10":{"name":"stdout","text":"[iter=9] obj_s=1.431e-01 feas=5.010e-02 station=6.603e-02 alpha=1.33e+00 beta=9.65e-01 lam=1.0e+01 kkt_res=5.8e+00 s_con=1.00e+00\n"},"100":{"name":"stdout","text":"[iter=99] obj_s=3.427e-02 feas=2.757e-04 station=5.700e-03 alpha=1.33e+00 beta=7.25e-01 lam=1.0e+01 kkt_res=5.2e-01 s_con=1.00e+00\n"},"101":{"name":"stdout","text":"[iter=100] obj_s=3.421e-02 feas=2.615e-04 station=5.159e-03 alpha=1.33e+00 beta=7.23e-01 lam=1.0e+01 kkt_res=5.1e-01 s_con=1.00e+00\n"},"102":{"name":"stdout","text":"[iter=101] obj_s=3.416e-02 feas=2.492e-04 station=4.698e-03 alpha=1.32e+00 beta=7.21e-01 lam=1.0e+01 kkt_res=5.0e-01 s_con=1.00e+00\n"},"103":{"name":"stdout","text":"[iter=102] obj_s=3.411e-02 feas=2.383e-04 station=4.307e-03 alpha=1.32e+00 beta=7.19e-01 lam=1.0e+01 kkt_res=4.9e-01 s_con=1.00e+00\n"},"104":{"name":"stdout","text":"[iter=103] obj_s=3.407e-02 feas=2.285e-04 station=3.985e-03 alpha=1.32e+00 beta=7.17e-01 lam=1.0e+01 kkt_res=4.8e-01 s_con=1.00e+00\n"},"105":{"name":"stdout","text":"[iter=104] 