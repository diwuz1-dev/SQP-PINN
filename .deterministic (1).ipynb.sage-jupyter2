{"cell_type":"code","id":"439dbf","input":"import numpy as np\nimport jax\nimport jax.numpy as jnp\nfrom jax import random, grad, vmap\nimport matplotlib.pyplot as plt\n\nDTYPE = jnp.float64 if jax.config.jax_enable_x64 else jnp.float32\nEPS = 1e-12\n\n# ---------- NON-JIT helpers (robust) ----------\ndef predict_u(theta, shapes, X):\n    params = unflatten_params(theta, shapes)\n    return mlp_apply(params, X)[:, 0]  # (N,)\n\ndef u_and_ux(theta, shapes, X):\n    params = unflatten_params(theta, shapes)\n\n    def u_fun(xt):\n        return mlp_apply(params, xt[None, :])[0, 0]\n\n    u = vmap(u_fun)(X)            # (N,)\n    du = vmap(grad(u_fun))(X)     # (N,2)\n    ux = du[:, 0]\n    return u, ux\n\ndef pde_residual(theta, shapes, X_f, nu):\n    params = unflatten_params(theta, shapes)\n    return pde_residual_unscaled(params, X_f, nu)  # (N_f,)\n\n# ---------- grid utilities ----------\ndef make_grid_points(x_np, t_np):\n    T, X = np.meshgrid(t_np, x_np, indexing=\"ij\")  # (nt,nx)\n    X_grid = np.stack([X.reshape(-1), T.reshape(-1)], axis=1)  # (N,2)\n    return X_grid, T.shape\n\n# ---------- fixed-set samplers for evaluation ----------\ndef sample_pde_points(key, Nf):\n    kx, kt = random.split(key, 2)\n    x = random.uniform(kx, (Nf, 1), minval=-1.0, maxval=1.0, dtype=DTYPE)\n    t = random.uniform(kt, (Nf, 1), minval=0.0, maxval=1.0, dtype=DTYPE)\n    return jnp.concatenate([x, t], axis=1)\n\ndef sample_periodic_bc_points(key, Nbc):\n    t = random.uniform(key, (Nbc, 1), minval=0.0, maxval=1.0, dtype=DTYPE)\n    XL = jnp.concatenate([-jnp.ones_like(t), t], axis=1)\n    XR = jnp.concatenate([ jnp.ones_like(t), t], axis=1)\n    return XL, XR\n\ndef sample_ic_from_grid(key, x_grid, u0_grid, Nic):\n    nx = x_grid.shape[0]\n    idx = random.randint(key, (Nic,), 0, nx)\n    x = x_grid[idx].reshape(-1, 1)\n    t = jnp.zeros_like(x)\n    Xic = jnp.concatenate([x, t], axis=1)\n    u0 = u0_grid[idx]\n    return Xic, u0\n\n# ---------- evaluation: data fit on full grid ----------\ndef eval_data_full_grid(theta, shapes, x_np, t_np, usol_np):\n    X_grid_np, grid_shape = make_grid_points(x_np, t_np)\n    X_grid = jnp.array(X_grid_np, dtype=DTYPE)\n\n    u_pred = np.array(predict_u(theta, shapes, X_grid)).reshape(grid_shape)  # (nt,nx)\n    u_true = usol_np\n\n    mse = float(np.mean((u_pred - u_true) ** 2))\n    rmse = float(np.sqrt(mse))\n    rel_l2 = float(np.linalg.norm(u_pred - u_true) / (np.linalg.norm(u_true) + 1e-12))\n    max_abs = float(np.max(np.abs(u_pred - u_true)))\n\n    return mse, rmse, rel_l2, max_abs, u_pred\n\n# ---------- evaluation: constraints on fixed random sets ----------\ndef eval_constraints_fixed(theta, shapes, nu, x_np, usol_np, Nf=5000, Nbc=2000, Nic=2000, seed=999):\n    key = random.PRNGKey(seed)\n    key, kf, kbc, kic = random.split(key, 4)\n\n    # PDE residual\n    X_f = sample_pde_points(kf, Nf)\n    r = np.array(pde_residual(theta, shapes, X_f, nu))\n    pde_mse = float(np.mean(r**2))\n    pde_rmse = float(np.sqrt(pde_mse))\n    pde_max = float(np.max(np.abs(r)))\n\n    # periodic BC value + derivative\n    XL, XR = sample_periodic_bc_points(kbc, Nbc)\n    uL, uxL = u_and_ux(theta, shapes, XL)\n    uR, uxR = u_and_ux(theta, shapes, XR)\n    uL, uxL, uR, uxR = map(np.array, [uL, uxL, uR, uxR])\n\n    bc_val = uL - uR\n    bc_der = uxL - uxR\n\n    bc_val_mse = float(np.mean(bc_val**2))\n    bc_val_rmse = float(np.sqrt(bc_val_mse))\n    bc_val_max = float(np.max(np.abs(bc_val)))\n\n    bc_der_mse = float(np.mean(bc_der**2))\n    bc_der_rmse = float(np.sqrt(bc_der_mse))\n    bc_der_max = float(np.max(np.abs(bc_der)))\n\n    # IC at t=0 from data\n    x_grid = jnp.array(x_np, dtype=DTYPE)\n    u0_grid = jnp.array(usol_np[0, :], dtype=DTYPE)\n    X_ic, u0 = sample_ic_from_grid(kic, x_grid, u0_grid, Nic)\n    u_ic = np.array(predict_u(theta, shapes, X_ic))\n    u0 = np.array(u0)\n\n    ic_err = u_ic - u0\n    ic_mse = float(np.mean(ic_err**2))\n    ic_rmse = float(np.sqrt(ic_mse))\n    ic_max = float(np.max(np.abs(ic_err)))\n\n    return {\n        \"pde_mse\": pde_mse, \"pde_rmse\": pde_rmse, \"pde_max\": pde_max,\n        \"bc_val_mse\": bc_val_mse, \"bc_val_rmse\": bc_val_rmse, \"bc_val_max\": bc_val_max,\n        \"bc_der_mse\": bc_der_mse, \"bc_der_rmse\": bc_der_rmse, \"bc_der_max\": bc_der_max,\n        \"ic_mse\": ic_mse, \"ic_rmse\": ic_rmse, \"ic_max\": ic_max,\n    }\n\n# ---------- RUN ----------\nmse, rmse, rel_l2, max_abs, u_pred = eval_data_full_grid(theta_star, shapes, x_np, t_np, usol_np)\nprint(\"[DATA fit on full grid]\")\nprint(f\"  MSE    = {mse:.3e}\")\nprint(f\"  RMSE   = {rmse:.3e}\")\nprint(f\"  relL2  = {rel_l2:.3e}\")\nprint(f\"  max|e| = {max_abs:.3e}\")\n\ncons = eval_constraints_fixed(theta_star, shapes, nu, x_np, usol_np, Nf=5000, Nbc=2000, Nic=2000, seed=999)\nprint(\"\\n[CONSTRAINTS on fixed random sets]\")\nfor k, v in cons.items():\n    print(f\"  {k:12s} = {v:.3e}\")\n\n# Plot slice\nti = min(100, usol_np.shape[0] - 1)\nplt.figure()\nplt.plot(x_np, usol_np[ti, :], label=\"true\")\nplt.plot(x_np, u_pred[ti, :], \"--\", label=\"pred\")\nplt.legend()\nplt.title(f\"Slice at t={t_np[ti]:.3f}\")\nplt.show()\n\n# Plot error heatmap\nplt.figure()\nplt.imshow(u_pred - usol_np, aspect=\"auto\", origin=\"lower\",\n           extent=[x_np[0], x_np[-1], t_np[0], t_np[-1]])\nplt.colorbar()\nplt.title(\"Error: u_pred - u_true\")\nplt.xlabel(\"x\")\nplt.ylabel(\"t\")\nplt.show()\n","pos":2,"state":"done","type":"cell"}
